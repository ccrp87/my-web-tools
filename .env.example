# Herramienta /farmacia — comparador de precios de droguerías.
# Copia este archivo a .env.local y completa los valores.

# Usuario que puede iniciar sesión en /farmacia.
FARMACIA_USER=

# Hash de la contraseña, no la contraseña en texto plano. Genéralo con:
#   node scripts/generar-hash-clave.mjs "tu-contraseña"
FARMACIA_PASSWORD_HASH=

# Secreto usado para firmar la cookie de sesión (HMAC). Cualquier cadena
# larga y aleatoria sirve, por ejemplo la salida de:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FARMACIA_SESSION_SECRET=

# Opcional: contacto mostrado en el header "From" hacia las droguerías.
# FARMACIA_CONTACTO=tu-correo@ejemplo.com
